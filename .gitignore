# Project specific
test_data/
*.pt
!data/models/*.pt
# Coworker's own trained matcher checkpoint (Scope #2 port) -- tiny (~8KB,
# a 1,121-parameter network, not a training-scale checkpoint), part of his
# real repo, kept for the same "exact unification" reason as everything
# else ported alongside it.
!components/scope2/data/models/*.pt

# Dataset init cache (auto-generated, invalidated on new traces)
.dataset_cache.pkl
.dataset_cache_combined_*.pkl
embed_cache.pkl

# Trace output — large JSON files, never committed
data/output/traces/
tasks/form_filling/traces_aug/

# Recorded demos — thousands of per-step JSON files, generated training data
data/demos/
data/output/submissions/
data/output/transformer_training_log.jsonl

# Run outputs (generated, not source)
data/output/rulesets/
data/output/bc_progress.jsonl
data/output/run_metrics.jsonl
train_log.txt
black.txt

# Rule extraction outputs
tasks/form_filling/2026*.md

# Trained model weights (large binaries)
data/models/*.pt
data/models/*.pth
data/models/*.bin

# Temporary files
*.tmp
*.log

# Environment / secrets
.env
*.env

# Personal thesis document — kept local, not pushed to GitHub
Thesis.docx

# Scope #2 (coworker port) embedding cache — auto-generated on first
# eval/run_variants.py run, same reason as embed_cache.pkl above: derived,
# regenerable, invalidated whenever the underlying sentence-transformer
# model or feature set changes.
components/scope2/data/cache/

# Excel's own transient lock file, created whenever a workbook is open --
# appears now that the Play panel's "Test" section can open grade_sheet.xlsx.
~$*.xlsx

# Inbox Router (Scope #3) — real Google OAuth credentials/tokens, and any
# local state that carries real personal inbox content once Phase B (a real
# Gmail account) is wired in. Never committed, same principle as .env above.
components/inbox_router/credentials/client_secret.json
components/inbox_router/credentials/token.json
components/inbox_router/data/pattern_profile.json
components/inbox_router/data/routed_history.json
# Mock-fixture generated state — mock_inbox.json itself IS committed
# (synthetic test data), only what it generates at runtime is ignored.
components/inbox_router/data/mock_state.json
components/inbox_router/data/mock_drafts.json

# Exported Electron build (electron-builder --dir output, copied to root
# on request) — a ~266MB local artifact, never something to commit.
/Intern-app/
